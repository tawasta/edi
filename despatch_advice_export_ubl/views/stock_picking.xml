<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.despatch.advice</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button
                    name="export_despatch_advice_ubl_file"
                    string="Generate UBL"
                    type="object"
                    groups="despatch_advice_export_ubl.group_despatch_advice_export"
                    class="oe_highlight"
                />
            </xpath>

            <xpath
                expr="//group[@name='other_infos']//field[@name='company_id']"
                position="after"
            >
                <field
                    name="ubl_export_done"
                    groups="despatch_advice_export_ubl.group_despatch_advice_export"
                />
            </xpath>
        </field>
    </record>
</odoo>
