<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_despatch_advice" model="ir.actions.report">
        <field name="name">Despatch Advice – UBL export</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >despatch_advice_export_ubl.report_despatch_advice_ubl</field>
        <field
            name="report_file"
        >despatch_advice_export_ubl.report_despatch_advice_ubl</field>
        <field name="print_report_name">'Despatch Advice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_picking" />
        <field name="binding_type">report</field>
    </record>

    <template id="despatch_advice_export_ubl.report_despatch_advice_ubl">
        <t t-foreach="docs" t-as="o">
            <t t-call="stock.report_delivery_document" t-lang="o._get_report_lang()" />
        </t>
    </template>
</odoo>
