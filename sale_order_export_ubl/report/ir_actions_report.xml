<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_saleorder" model="ir.actions.report">
        <field name="name">Quotation / Order – UBL export</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_order_export_ubl.report_saleorder_ubl</field>
        <field name="report_file">sale_order_export_ubl.report_saleorder_ubl</field>
        <field
            name="print_report_name"
        >(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_sale_order" />
        <field name="binding_type">report</field>
    </record>

    <template id="sale_order_export_ubl.report_saleorder_ubl">
        <t t-call="sale.report_saleorder_raw" />
    </template>
</odoo>
