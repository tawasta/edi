<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="export_finvoice" inherit_id="account_edi_finvoice.export_finvoice">
        <xpath expr="//InvoiceRow[1]" position="before">
            <FactoringAgreementDetails t-if="record.factoring_contract_id">
                <FactoringAgreementIdentifier
                    t-esc="record.factoring_contract_id.identifier"
                />
                <FactoringTypeCode
                    t-if="record.factoring_contract_id.type_code"
                    t-esc="record.factoring_contract_id.type_code"
                />
            </FactoringAgreementDetails>
        </xpath>
    </template>
</odoo>
